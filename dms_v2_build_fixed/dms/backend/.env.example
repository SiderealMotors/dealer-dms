DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dms?schema=public"
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"

# Supabase JWT secret (Project Settings → API → JWT Secret)
SUPABASE_JWT_SECRET="replace-with-supabase-jwt-secret"

# Local-only: bypasses JWT verification for development
AUTH_DISABLED="false"
DEV_ROLE="ADMIN"
