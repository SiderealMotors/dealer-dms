generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  ACCOUNTANT
}

/// Listing lifecycle: SOLD is always set automatically when dateSold is present.
enum VehicleStatus {
  AVAILABLE
  PENDING
  SOLD
}

// --- CRM enums ---

/// Kanban pipeline stages (persisted on `Lead.status`).
enum LeadStatus {
  NEW_LEAD
  CONTACTED
  NEGOTIATING
  CLOSED
}

enum LeadSource {
  WALK_IN
  PHONE
  WEB
  REFERRAL
  SOCIAL
  OTHER
}

enum CustomerVehicleRole {
  INTERESTED
  BUYER
  CO_BUYER
}

enum DealStage {
  OPEN
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum InteractionChannel {
  CALL
  EMAIL
  SMS
  VISIT
  NOTE
  OTHER
}

enum CrmTaskStatus {
  OPEN
  DONE
  CANCELLED
}

// --- Double-entry GL ---

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalStatus {
  DRAFT
  POSTED
}

/// Domain entities that support structured audit history (`EntityAuditLog`).
enum AuditEntityType {
  VEHICLE
  DEAL
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  fullName       String
  role           Role
  supabaseUserId String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vehiclesSold Vehicle[] @relation("VehicleSalesperson")
  auditLogs    EntityAuditLog[]
  commissionRule CommissionRule?
}

/// Field-level change log: who, what changed, when (see `changes` JSON).
model EntityAuditLog {
  id          String          @id @default(cuid())
  entityType  AuditEntityType
  entityId    String
  actorUserId String?
  actorEmail  String?
  /// `{ fieldName: { from, to } }` with JSON-safe scalars (dates as ISO strings, decimals as strings).
  changes     Json
  createdAt   DateTime        @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorUserId])
}

/// Core inventory record. Monetary fields are stored as inputs only;
/// derived taxes, totals, lot days, and profit are computed in the service layer.
model Vehicle {
  id String @id @default(cuid())

  datePurchased DateTime @db.Date
  /// Unique among **non-deleted** rows (partial unique index in DB).
  vin           String
  year          Int
  make          String
  model         String
  trim          String
  colour        String
  odometer      Int

  status VehicleStatus @default(AVAILABLE)

  purchasePrice Decimal @db.Decimal(12, 2)

  safetyEstimate Decimal? @db.Decimal(12, 2)
  safetyCost     Decimal  @default(0) @db.Decimal(12, 2)

  floorplanInterestCost Decimal @default(0) @db.Decimal(12, 2)
  gas                   Decimal @default(0) @db.Decimal(12, 2)
  warrantyCost          Decimal @default(0) @db.Decimal(12, 2)

  dateSold      DateTime? @db.Date
  sellingPrice  Decimal?  @db.Decimal(12, 2)
  safetyCharge  Decimal?  @db.Decimal(12, 2)
  warrantyCharge Decimal? @db.Decimal(12, 2)
  omvicFee      Decimal?  @db.Decimal(12, 2)

  buyerName       String?
  referralAmount  Decimal @default(0) @db.Decimal(12, 2)
  paymentMethod   String?
  depositAmount   Decimal? @db.Decimal(12, 2)

  salesPersonId   String?
  salesPerson     User?   @relation("VehicleSalesperson", fields: [salesPersonId], references: [id], onDelete: SetNull)
  salesPersonName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  ledgerEntries VehicleLedgerEntry[]

  /// Tag journals created from this vehicle sale (idempotency).
  glRevenueJournalId String? @unique
  glCogsJournalId    String? @unique
  glRevenueJournal   JournalEntry? @relation("GlVehicleRevenueJournal", fields: [glRevenueJournalId], references: [id], onDelete: SetNull)
  glCogsJournal      JournalEntry? @relation("GlVehicleCogsJournal", fields: [glCogsJournalId], references: [id], onDelete: SetNull)

  journalEntries JournalEntry[] @relation("JournalEntryVehicleTag")
  customerLinks  CustomerVehicle[]
  leadsInterested Lead[]             @relation("LeadVehicleInterest")
  deals           Deal[]
  photos          VehiclePhoto[]
  expenses        Expense[]

  @@index([dateSold])
  @@index([status])
  @@index([salesPersonId])
  @@index([vin])
  @@index([deletedAt])
}

/// Canonical person / company contact for CRM.
model Customer {
  id        String   @id @default(cuid())
  fullName  String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  leads         Lead[]            @relation("LeadCustomer")
  deals         Deal[]
  vehicleLinks  CustomerVehicle[]
  notes         CustomerNote[]
  interactions  InteractionLog[]
  tasks         CrmTask[]

  @@index([email])
  @@index([fullName])
  @@index([deletedAt])
}

/// Many-to-many: customers interested in or buying a vehicle.
model CustomerVehicle {
  id         String              @id @default(cuid())
  customerId String
  vehicleId  String
  role       CustomerVehicleRole @default(INTERESTED)
  createdAt  DateTime            @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([customerId, vehicleId])
  @@index([vehicleId])
  @@index([customerId])
}

/// Sales lead: always tied to a customer; optional vehicle interest; stage drives the pipeline board.
model Lead {
  id       String     @id @default(cuid())
  fullName String
  phone    String?
  email    String?
  status   LeadStatus @default(NEW_LEAD)
  source   LeadSource @default(OTHER)
  summary  String?

  customerId String
  vehicleId  String?

  customer Customer @relation("LeadCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  vehicle  Vehicle? @relation("LeadVehicleInterest", fields: [vehicleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([customerId])
  @@index([vehicleId])
  @@index([deletedAt])
}

/// Sales deal / opportunity; always belongs to a customer, optionally tied to a vehicle.
model Deal {
  id         String     @id @default(cuid())
  customerId String
  vehicleId  String?
  title      String
  value      Decimal?   @db.Decimal(12, 2)
  stage      DealStage  @default(OPEN)
  closedAt   DateTime?
  notes      String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle  Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  tasks    CrmTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@index([vehicleId])
  @@index([stage])
  @@index([deletedAt])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  body       String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model InteractionLog {
  id          String              @id @default(cuid())
  customerId  String
  channel     InteractionChannel
  summary     String
  detail      String?
  occurredAt  DateTime            @default(now())
  createdById String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([occurredAt])
}

model CrmTask {
  id          String        @id @default(cuid())
  customerId  String
  dealId      String?
  title       String
  description String?
  dueAt       DateTime?
  status      CrmTaskStatus @default(OPEN)
  completedAt DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal     Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@index([dealId])
  @@index([dueAt])
  @@index([status])
  @@index([deletedAt])
}

/// Simple accounting line items tied to vehicles for foundation reporting.
model VehicleLedgerEntry {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  occurredOn  DateTime @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vehicleId])
}

/// Chart of accounts (GL).
model GlAccount {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  type          AccountType
  normalBalance NormalBalance
  isActive      Boolean        @default(true)
  description   String?
  parentId      String?
  parent        GlAccount?     @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      GlAccount[]    @relation("AccountHierarchy")

  lines JournalLine[]
  expenses Expense[]
  @@index([parentId])
}

/// Double-entry journal header.
model JournalEntry {
  id          String        @id @default(cuid())
  entryNum    Int           @unique @default(autoincrement())
  entryDate   DateTime      @db.Date
  description String
  memo        String?
  status      JournalStatus @default(DRAFT)
  postedAt    DateTime?

  vehicleId String?
  vehicle   Vehicle? @relation("JournalEntryVehicleTag", fields: [vehicleId], references: [id], onDelete: SetNull)

  glRevenueForVehicle Vehicle? @relation("GlVehicleRevenueJournal")
  glCogsForVehicle    Vehicle? @relation("GlVehicleCogsJournal")

  lines JournalLine[]
  expenses Expense[]
  hstRemittances HstRemittance[]
  @@index([createdAt])
  @@index([status])
  @@index([vehicleId])
}

/// One line per journal entry: either debit or credit (never both; enforced in DB + app).
model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  lineNumber     Int
  accountId      String
  account        GlAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debitAmount    Decimal      @default(0) @db.Decimal(14, 2)
  creditAmount   Decimal      @default(0) @db.Decimal(14, 2)
  memo           String?

  @@unique([journalEntryId, lineNumber])
  @@index([accountId])
}

// ── New models added in 20250526 migration ──────────────────────────────────

model DealerSettings {
  id              String   @id @default("singleton")
  dealerName      String   @default("My Dealership")
  address         String?
  city            String?
  province        String   @default("ON")
  postalCode      String?
  phone           String?
  email           String?
  website         String?
  hstNumber       String?
  omvicNumber     String?
  hstRate         Decimal  @default(0.13) @db.Decimal(5, 4)
  defaultOmvicFee Decimal  @default(75.00) @db.Decimal(10, 2)
  logoUrl         String?
  updatedAt       DateTime @updatedAt
}

enum ExpenseCategory {
  ADVERTISING
  BANK_CHARGES
  FLOORPLAN_INTEREST
  INSURANCE
  OFFICE_SUPPLIES
  OMVIC_FEES
  RENT
  REPAIRS_MAINTENANCE
  SALARIES_WAGES
  UTILITIES
  VEHICLE_PURCHASE
  OTHER
}

model Expense {
  id           String          @id @default(cuid())
  date         DateTime        @db.Date
  category     ExpenseCategory
  vendor       String?
  description  String
  amountPreTax Decimal         @db.Decimal(12, 2)
  hstAmount    Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal         @db.Decimal(12, 2)
  receiptUrl   String?
  glAccountId  String?
  glAccount    GlAccount?      @relation(fields: [glAccountId], references: [id], onDelete: SetNull)
  journalEntryId String?
  journalEntry JournalEntry?   @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  vehicleId    String?
  vehicle      Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdById  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?

  @@index([date])
  @@index([category])
  @@index([deletedAt])
  @@index([vehicleId])
}

model VehiclePhoto {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([vehicleId])
}

model CommissionRule {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleType         String   @default("FLAT")
  flatAmount       Decimal? @db.Decimal(10, 2)
  percentOfProfit  Decimal? @db.Decimal(5, 4)
  minProfit        Decimal? @db.Decimal(10, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model HstRemittance {
  id             String    @id @default(cuid())
  periodStart    DateTime  @db.Date
  periodEnd      DateTime  @db.Date
  hstCollected   Decimal   @default(0) @db.Decimal(12, 2)
  hstPaid        Decimal   @default(0) @db.Decimal(12, 2)
  netOwing       Decimal   @default(0) @db.Decimal(12, 2)
  filedAt        DateTime?
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
